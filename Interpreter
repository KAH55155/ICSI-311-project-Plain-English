package PlainEnglish;

import PlainEnglish.AST.*;
import java.util.HashMap;
import java.util.Stack;
import java.util.Optional;

public class Interpreter {
    private final Program program;
    private Stack<HashMap<String, InterpreterDataType>> scopes = new Stack<>();

    public Interpreter(Program prog) {
        program = prog;
    }

    public void Start() {
        scopes.push(new HashMap<>());

        for(int i =0; i<program.method.size(); i++){
            Method m = program.method.get(i);

            if(m.name.equals("Run") && m.parameter.isEmpty()){
                DoMethod(m, new HashMap<>());
            }
        }
    }

        public void DoMethod(Method m, HashMap<String, InterpreterDataType> args){
        scopes.push(args);
        DoStatementBlock(m.statementblock);
        scopes.pop();
        }

        public void DoStatementBlock(StatementBlock block){

        for(int i =0; i < block.statement.size(); i++){
            DoStatement(block.statement.get(i));
        }
    }
        public void DoStatement(Statement s){

        if(s.make.isPresent()){
            DoMake(s.make.get());
        }else if(s.set.isPresent()){
            DoSet(s.set.get());
        }else if(s.functioncall.isPresent()){
            DoFunctionCall(s.functioncall.get());
        }else if(s.$if.isPresent()){
            DoIf(s.$if.get());
        }else if(s.loop.isPresent()){
            DoLoop(s.loop.get());
        }
    }

        void DoFunctionCall(FunctionCall f){

            if (f.name.equals("Print")) {
                for (Expression param : f.parameter) {
                    InterpreterDataType val = DoExpression(param);
                    System.out.println(val);
                }
                return;
            }

            Method target = findMethod(f.name, f.obj);

            if (target == null) {
                throw new RuntimeException("Method not found: " + f.name);
            }

            HashMap<String, InterpreterDataType> args = new HashMap<>();

            String[] callerVarNames = new String[target.parameter.size()];

            for (int i = 0; i < target.parameter.size(); i++) {
                Parameter p = target.parameter.get(i);

                String argName;

                if(p.nameOverride.isPresent()){
                    argName = p.nameOverride.get();
                }else{
                    argName = p.paramType;
                }

                if (i < f.parameter.size()) {
                    Expression argExpr = f.parameter.get(i);
                    InterpreterDataType val = DoExpression(argExpr);
                    args.put(argName, val);

                    try {
                        Term t = argExpr.term.get(0);
                        if (argExpr.term.size() == 1 && t.factor.size() == 1) {
                            Factor fac = t.factor.get(0);
                            if (fac.variablereference.isPresent()) {
                                callerVarNames[i] = fac.variablereference.get().name;
                            }
                        }
                    } catch (Exception ignored) {}
                }
            }

            DoMethod(target, args);

            for (int i = 0; i < target.parameter.size(); i++) {

                if (callerVarNames[i] != null) {
                    Parameter p = target.parameter.get(i);
                    String argName;

                    if(p.nameOverride.isPresent()){
                        argName = p.nameOverride.get();
                    }else{
                        argName = p.paramType;
                    }

                    InterpreterDataType finalVal = args.get(argName);

                    for (int s = scopes.size() - 1; s >= 0; s--) {
                        if (scopes.get(s).containsKey(callerVarNames[i])) {
                            scopes.get(s).put(callerVarNames[i], finalVal);
                            break;
                        }
                    }
                }
            }

        }

        private Method findMethod(String name, Optional<String> obj){

            for (int i =0; i < program.method.size(); i++) {

                Method m = program.method.get(i);

                if (!m.name.equals(name)){
                    continue;
                }
                if (obj.isPresent()) {
                    if (m.className.isPresent() && m.className.get().equals(obj.get())){
                        return m;
                    }
                } else {
                    return m;
                }
            }
        return null;
        }

        public void DoIf(If i){

            if (evaluateBool(i.boolexpterm)) {
                DoStatementBlock(i.statementblock);
            } else if (i.$else && i.falseCase.isPresent()) {
                DoStatementBlock(i.falseCase.get());
            }
    }

        public void DoLoop(Loop l){

            while (evaluateBool(l.boolexpterm)) {
                DoStatementBlock(l.statementblock);
            }
        }

        public void DoSet(Set s){

            String name = s.variablereference.name;
            InterpreterDataType value = DoExpression(s.expression);

            if (s.variablereference.of && s.variablereference.$object.isPresent()) {
                String objName = s.variablereference.$object.get();
                InterpreterDataType obj = lookup(objName);
                if (obj instanceof ObjectInterpreterDataType) {
                    ((ObjectInterpreterDataType) obj).fields.put(name, value);
                    return;
                }
            }

            for (int i = scopes.size() - 1; i >= 0; i--) {
                if (scopes.get(i).containsKey(name)) {
                    scopes.get(i).put(name, value);
                    return;
                }
            }
            scopes.peek().put(name, value);
        }

        public void DoMake(Make m){

            InterpreterDataType value;

            switch (m.type) {
                case "number":
                    value = new NumberInterpreterDataType(0);
                    break;
                case "string":
                    value = new StringInterpreterDataType("");
                    break;
                case "boolean":
                    value = new BooleanInterpreterDataType(false);
                    break;
                default:

                    value = new ObjectInterpreterDataType();

                    for (int i =0; i < program.typedef.size(); i++) {

                        TypeDef td = program.typedef.get(i);

                        if (td.name.equals(m.type)) {
                            for (int j =0; j < td.field.size(); j++) {

                                Field f = td.field.get(j);

                                InterpreterDataType fieldDefault = defaultForType(f.type);
                                ((ObjectInterpreterDataType) value).fields.put(f.name, fieldDefault);
                            }
                            break;
                        }
                    }
                    break;
            }
            scopes.peek().put(m.name, value);
        }

        private InterpreterDataType defaultForType(String type){

            if (type.equals("number")) {
                return new NumberInterpreterDataType(0);

            } else if (type.equals("string")) {
                return new StringInterpreterDataType("");

            } else if (type.equals("boolean")) {
                return new BooleanInterpreterDataType(false);
            }
            return new ObjectInterpreterDataType();
        }

        InterpreterDataType DoExpression(Expression e){

            InterpreterDataType result = DoTerm(e.term.get(0));

            for (int i = 1; i < e.term.size(); i++) {
                InterpreterDataType next = DoTerm(e.term.get(i));
                plusORhyphen op = e.theplusORhyphen.get(i - 1);

                if (result instanceof StringInterpreterDataType || next instanceof StringInterpreterDataType) {
                    if (op == plusORhyphen.plus) {
                        result = new StringInterpreterDataType(result.toString() + next.toString());
                    } else {
                        throw new RuntimeException("Cannot subtract strings");
                    }
                } else {
                    float a = toFloat(result);
                    float b = toFloat(next);

                    if(op == plusORhyphen.plus) {
                        result = new NumberInterpreterDataType(a + b);
                    }else{
                        result = new NumberInterpreterDataType(a - b);
                    }
                }
            }
            return result;
        }

        InterpreterDataType DoTerm(Term t){

            InterpreterDataType result = DoFactor(t.factor.get(0));

            for (int i = 1; i < t.factor.size(); i++) {
                InterpreterDataType next = DoFactor(t.factor.get(i));
                float a = toFloat(result);
                float b = toFloat(next);

                asteriskORslashORpercent op = t.theasteriskORslashORpercent.get(i - 1);

                if (op == asteriskORslashORpercent.asterisk) {
                    result = new NumberInterpreterDataType(a * b);

                } else if (op == asteriskORslashORpercent.slash) {
                    result = new NumberInterpreterDataType(a / b);

                } else {
                    result = new NumberInterpreterDataType(a % b);
                }
            }
            return result;
        }

        InterpreterDataType DoFactor(Factor f){

            if (f.number.isPresent()) {
                return new NumberInterpreterDataType(Float.parseFloat(f.number.get()));
            }
            if (f.stringliteral.isPresent()) {
                return new StringInterpreterDataType(f.stringliteral.get());
            }
            if (f.characterliteral.isPresent()) {
                return new StringInterpreterDataType(String.valueOf(f.characterliteral.get()));
            }
            if (f.$true) {
                return new BooleanInterpreterDataType(true);
            }
            if (f.$false){
                return new BooleanInterpreterDataType(false);
            }
            if (f.variablereference.isPresent()) {
                return fixVariableReference(f.variablereference.get());
            }
            if (f.expression.isPresent()) {
                return DoExpression(f.expression.get());
            }
            throw new RuntimeException("Empty factor");
        }

        private InterpreterDataType fixVariableReference(VariableReference ref){

            if (ref.of && ref.$object.isPresent()) {

                InterpreterDataType obj = lookup(ref.$object.get());
                if (obj instanceof ObjectInterpreterDataType) {
                    ObjectInterpreterDataType o = (ObjectInterpreterDataType) obj;
                    if (o.fields.containsKey(ref.name)) {
                        return o.fields.get(ref.name);
                    }
                }
                throw new RuntimeException("Field is not found: " + ref.name + " of " + ref.$object.get());
            }
            return lookup(ref.name);
        }

        public boolean evaluateBool(BoolExpTerm b){

            if (b.not) {
                return !evaluateBool(b.notTerm.get());
            }

            boolean result = evaluateBoolFactor(b.boolexpfactor.get());

            for (int i = 0; i < b.theandORor.size(); i++) {
                boolean next = evaluateBool(b.boolexpterm.get(i));
                if (b.theandORor.get(i) == andORor.and) {
                    result = result && next;
                } else {
                    result = result || next;
                }
            }
            return result;
        }

        public boolean evaluateBoolFactor(BoolExpFactor b){

            if (b.thecompareOps.isPresent()) {
                InterpreterDataType leftVal  = DoExpression(b.lhs.get());
                InterpreterDataType rightVal = DoExpression(b.rhs.get());

                if (leftVal instanceof StringInterpreterDataType || rightVal instanceof StringInterpreterDataType) {
                    String ls = leftVal.toString();
                    String rs = rightVal.toString();

                    if (b.thecompareOps.get() == compareOps.doubleequal) {
                        return ls.equals(rs);
                    } else if (b.thecompareOps.get() == compareOps.notequal) {
                        return !ls.equals(rs);
                    } else {
                        throw new RuntimeException("Strings only support == and !=");
                    }
                }

                float left  = toFloat(leftVal);
                float right = toFloat(rightVal);

                if (b.thecompareOps.get() == compareOps.doubleequal) {
                    return Math.abs(left - right) < 0.0001f;

                } else if (b.thecompareOps.get() == compareOps.notequal) {
                    return Math.abs(left - right) >= 0.0001f;

                } else if (b.thecompareOps.get() == compareOps.lessthan) {
                    return left < right;

                } else if (b.thecompareOps.get() == compareOps.greaterthan) {
                    return left > right;

                } else if (b.thecompareOps.get() == compareOps.lessthanequal) {
                    return left <= right;

                } else {
                    return left >= right;
                }
            }

            if (b.variablereference.isPresent()) {
                InterpreterDataType val = fixVariableReference(b.variablereference.get());
                if (val instanceof BooleanInterpreterDataType) {
                    return ((BooleanInterpreterDataType) val).value;
                }

                if (val instanceof NumberInterpreterDataType) {
                    return ((NumberInterpreterDataType) val).value != 0;
                }
            }
            return false;
        }

        private float toFloat(InterpreterDataType IDT){

        if(IDT instanceof NumberInterpreterDataType){
            return ((NumberInterpreterDataType) IDT).value;
        }

        if(IDT instanceof BooleanInterpreterDataType){
            if (((BooleanInterpreterDataType) IDT).value) {
                return 1f;
            } else {
                return 0f;
            }
        }

        try{
            return Float.parseFloat(IDT.toString());
        }catch(NumberFormatException e){
            throw new RuntimeException("Can't convert to number: "+ IDT);
        }
    }

        private InterpreterDataType lookup(String name){

        for(int i = scopes.size()-1; i>=0; i--){

            if(scopes.get(i).containsKey(name)){
                return scopes.get(i).get(name);
            }
        }
        throw new RuntimeException("Variable not found: "+name);
    }
}
